{
  "name": "@multiversx/sdk-dapp-ui",
  "version": "0.1.25-alpha.5",
  "description": "A library to hold UI components for a dApp on the MultiversX blockchain",
  "author": "MultiversX",
  "license": "MIT",
  "module": "dist/web-components/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/web-components/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils/getDetectedBrowser": {
      "import": "./dist/utils/utils/getDetectedBrowser.js",
      "require": "./dist/cjs/utils/getDetectedBrowser.js",
      "types": "./dist/types/utils/getDetectedBrowser.d.ts"
    },
    "./utils/constants/browser.enum": {
      "import": "./dist/utils/constants/browser.enum.js",
      "require": "./dist/cjs/constants/browser.enum.js",
      "types": "./dist/types/constants/browser.enum.d.ts"
    },
    "./utils/EventBus": {
      "import": "./dist/utils/utils/EventBus.js",
      "require": "./dist/cjs/utils/EventBus.js",
      "types": "./dist/types/utils/EventBus.d.ts"
    },
    "./utils/getIsMetaMaskAvailable": {
      "import": "./dist/utils/components/functional/unlock-panel/helpers/getIsMetaMaskAvailable.js",
      "require": "./dist/cjs/components/functional/unlock-panel/helpers/getIsMetaMaskAvailable.js",
      "types": "./dist/types/components/functional/unlock-panel/helpers/getIsMetaMaskAvailable.d.ts"
    },
    "./utils/getIsExtensionAvailable": {
      "import": "./dist/utils/components/functional/unlock-panel/helpers/getIsExtensionAvailable.js",
      "require": "./dist/cjs/components/functional/unlock-panel/helpers/getIsExtensionAvailable.js",
      "types": "./dist/types/components/functional/unlock-panel/helpers/getIsExtensionAvailable.d.ts"
    },
    "./mvx-unlock-panel": {
      "import": "./dist/web-components/mvx-unlock-panel.js",
      "types": "./dist/web-components/mvx-unlock-panel.d.ts"
    },
    "./mvx-wallet-connect": {
      "import": "./dist/web-components/mvx-wallet-connect.js",
      "types": "./dist/web-components/mvx-wallet-connect.d.ts"
    },
    "./mvx-toast-list": {
      "import": "./dist/web-components/mvx-toast-list.js",
      "types": "./dist/web-components/mvx-toast-list.d.ts"
    },
    "./mvx-ledger-connect": {
      "import": "./dist/web-components/mvx-ledger-connect.js",
      "types": "./dist/web-components/mvx-ledger-connect.d.ts"
    },
    "./mvx-notifications-feed": {
      "import": "./dist/web-components/mvx-notifications-feed.js",
      "types": "./dist/web-components/mvx-notifications-feed.d.ts"
    },
    "./mvx-pending-transactions-panel": {
      "import": "./dist/web-components/mvx-pending-transactions-panel.js",
      "types": "./dist/web-components/mvx-pending-transactions-panel.d.ts"
    },
    "./mvx-sign-transactions-panel": {
      "import": "./dist/web-components/mvx-sign-transactions-panel.js",
      "types": "./dist/web-components/mvx-sign-transactions-panel.d.ts"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts"
    },
    "./web-components/*": {
      "import": "./dist/web-components/*.js",
      "types": "./dist/web-components/*.d.ts"
    },
    "./react": {
      "types": "./dist/react/components.ts",
      "import": "./dist/react/components.ts",
      "require": "./dist/react/components.ts"
    },
    "./vue": {
      "types": "./dist/vue/components.ts",
      "import": "./dist/vue/components.ts",
      "require": "./dist/vue/components.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/multiversx/mx-sdk-dapp-ui.git"
  },
  "files": [
    "dist/*",
    "!**/*.stories.*",
    "!**/*.test.*",
    "!**/__mocks__/**",
    "!**/__tests__/**"
  ],
  "scripts": {
    "test": "stencil test --spec --e2e",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "unpublish-verdaccio": "npm unpublish @multiversx/sdk-dapp-ui --force --registry http://localhost:4873",
    "publish-verdaccio": "pnpm unpublish-verdaccio && pnpm build && npm publish --registry http://localhost:4873/",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "build:dev": "stencil build --dev",
    "build:esm:utils": "tsc -p tsconfig.utils.esm.json && tsc-alias -p tsconfig.utils.esm.json",
    "build:cjs:utils": "tsc -p tsconfig.utils.cjs.json && tsc-alias -p tsconfig.utils.cjs.json",
    "build": "stencil build --prod && pnpm assert:css && pnpm build:esm:utils && pnpm build:cjs:utils",
    "start": "pnpm build:dev --watch --serve",
    "storybook-build-tailwind": "node .storybook/generate-safelist.ts && pnpm exec tailwindcss -i src/global/tailwind.css -o .storybook/tailwind.css --content '.storybook/tailwind-safelist.html' && rm -f .storybook/tailwind-safelist.html",
    "storybook-dev": "pnpm build && pnpm storybook-build-tailwind && storybook dev -p 6006 --no-open",
    "storybook-build": "pnpm build && pnpm storybook-build-tailwind && storybook build",
    "audit": "pnpm audit --audit-level=high",
    "assert:css": "node scripts/assert-no-preflight-leak.mjs"
  },
  "dependencies": {
    "@stencil/core": "^4.44.0",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/vue-output-target": "^0.14.1",
    "classnames": "^2.5.1",
    "lodash.capitalize": "^4.2.1",
    "lodash.inrange": "^3.3.0",
    "lodash.range": "^3.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.6.0",
    "@rollup/plugin-image": "^3.0.3",
    "@stencil/sass": "^3.3.3",
    "@stencil/store": "^2.2.4",
    "@stencil/storybook-plugin": "^0.7.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "postcss": "^8.5.26",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "puppeteer": "^24.43.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "sass-embedded": "^1.102.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
