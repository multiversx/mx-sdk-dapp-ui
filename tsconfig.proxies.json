{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "dist",
    "outDir": "dist"
  },
  "files": ["dist/react/components.ts", "dist/vue/components.ts"],
  "exclude": []
}
